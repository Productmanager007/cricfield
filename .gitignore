# Python
.venv/
__pycache__/
*.pyc

# Data — never commit the ball store or generated samples
data/
sample_data/
*.parquet
*.csv
# Source bundles are downloaded, never committed. This also keeps a stray
# ipl_json.zip out of `git status`, which is what the provenance check reads.
*.zip

# ...except the published IPL leaderboard, which is a result, not raw data
!ipl_fraa.csv

# ...and the baseline snapshots a model change was measured against. These are
# small and they are evidence: without them a committed era-effect comparison
# cannot be reproduced.
!baselines/*.csv

# Generated web export. Not tracked yet -- undecided whether these belong in
# the repo or should be built in CI. Covers the whole directory: the per-player
# split writes into web-data/seasons/, which web-data/*.json would not match.
web-data/

# Next.js frontend. public/data/ is copied from web-data/ at build time; the
# `data/` rule above already matches it, so it is listed here explicitly in
# case that rule is ever narrowed.
web/node_modules/
web/.next/
web/out/
web/public/data/
web/next-env.d.ts
web/*.tsbuildinfo

# OS / editor
.DS_Store

# Secrets
.env
